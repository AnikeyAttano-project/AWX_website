# ===== 3x-UI панель =====
XUI_BASE_URL=https://your-panel-url:port/webBasePath
XUI_API_TOKEN=your_bearer_token_from_panel

# Все видимые инбаунды через запятую (фильтруются те, что начинаются с "--!")
XUI_INBOUND_IDS=5,6,7,8,10,12,13,14

# Базовый URL subscription-сервера ( port 2096, НЕ api порт 2095!)
# Получите из панели: Settings → Subscription → subURI
XUI_SUB_BASE_URL=https://your-panel-host:2096/sub/

# SSL: отключить проверку сертификата для self-signed (3x-UI)
# В продакшене с валидным сертификатом установите "true"
XUI_VERIFY_SSL=false

# Retry-конфигурация для операций с 3x-UI (JSON-строка).
# retries — сколько попыток, base_delay — задержка перед первой повтором (сек),
# backoff — прирост задержки с каждой попыткой (сек).
# Можно удалить строку — тогда используются дефолты (3 / 0.5 / 1.0).
RETRY_CONFIG={"retries": 3, "base_delay": 0.5, "backoff": 1.0}

# ===== Platega =====
PLATEGA_MERCHANT_ID=your_merchant_id
PLATEGA_SECRET=your_api_key
PLATEGA_API_URL=https://app.platega.io
# Активная платёжка: platega | yookassa (по умолчанию platega).
# Меняется также в админке (Настройки → Платёжная система), значение из БД перекрывает .env.
PAYMENT_PROVIDER=platega
# ЮKassa (если PAYMENT_PROVIDER=yookassa)
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key

# ===== Сайт =====
SITE_BASE_URL=https://your-domain.com
DATABASE_PATH=orders.db

# ===== CORS =====
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000","https://your-domain.com"]

# ===== Admin panel =====
# API-ключ для /admin/* эндпоинтов. Передаётся в заголовке X-Admin-Key.
# Оставьте пустым, чтобы полностью отключить админ-панель (возвращает 503).
ADMIN_API_KEY=change_me_to_a_long_random_string

# ===== Email verification =====
EMAIL_VERIFICATION_REQUIRED=false

# ===== Telegram Login Widget =====
# Токен бота из @BotFather — обязателен для проверки подписи виджета.
# Имя бота (публичное) — по нему фронт рендерит кнопку «Войти через Telegram».
# Важно: домен сайта должен быть привязан в @BotFather → /setdomain (напр. awx-vpn.duckdns.org).
# Оставьте пустым, чтобы отключить Telegram-вход.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklmnoPQRstuvWXYZ
TELEGRAM_BOT_USERNAME=your_bot_username

# ===== Trial =====
TRIAL_ENABLED=true
TRIAL_DAYS=3
TRIAL_GB=25

# ===== Demo mode =====
# "Демо подписка" выдаёт ключ БЕЗ оплаты — ТОЛЬКО для тестирования!
# В продакшене установите false: кнопка скроется на витрине, а /api/order/demo отключится.
DEMO_MODE=true

# Пароль для демо-оплаты — вводится на витрине перед выдачей ключа.
# Также демо-режим можно скрыть через админ-панель (Настройки → Демо) без изменения кода.
DEMO_PASSWORD=AxZz123@Tt
